@model DispenseHistoryViewModel
@{
    ViewData["Title"] = "Lịch sử đơn trả thuốc";
    var fromDate = Model.FromDate;
    var toDate = Model.ToDate;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-clock-history"></i> Lịch sử đơn trả thuốc</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Đơn chờ cấp phát
        </a>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Từ ngày</label>
                    <input type="date" name="fromDate" class="form-control" value="@fromDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Đến ngày</label>
                    <input type="date" name="toDate" class="form-control" value="@toDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-funnel"></i> Lọc</button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Dispenses.Any())
    {
        <div class="alert alert-info">Không có đơn trả thuốc nào trong khoảng thời gian này.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-capsule"></i> Đã cấp phát (@Model.Dispenses.Count)</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Cấp lúc</th>
                            <th>Đơn thuốc</th>
                            <th>Bệnh nhân</th>
                            <th>Dược sĩ</th>
                            <th class="text-end">Tổng tiền</th>
                            <th>Ghi chú</th>
                            <th class="text-center">In</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Dispenses)
                        {
                            decimal total = d.Items?.Sum(x => x.TotalPrice) ?? 0;
                            <tr>
                                <td>@d.DispensedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <a asp-action="Detail" asp-route-id="@d.PrescriptionId">@d.Prescription?.Code</a>
                                </td>
                                <td>@d.Prescription?.Encounter?.Patient?.FullName</td>
                                <td>@d.Pharmacist?.FullName</td>
                                <td class="text-end">@total.ToString("N0") VND</td>
                                <td class="text-muted small">@d.Note</td>
                                <td class="text-center">
                                    <a asp-action="PrintReceipt" asp-route-id="@d.PrescriptionId" target="_blank" class="btn btn-sm btn-outline-primary" title="In phiếu thu tiền">
                                        <i class="bi bi-printer"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
